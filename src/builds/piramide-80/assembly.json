2]}, {"circle": [20.0, 43.5, 1.2]}], "a": [82.00000000000001, 82.60000000000001], "colour": "#FFC400", "frm": [0, 0, 80], "group": "back", "ply": null}, {"id": "cross-v", "name": "back brace", "kind": "box", "u": [29.9, 31.1], "v": [3.5, 57.5], "w": [77.8, 83.8], "colour": "#D9B77F", "frm": [0, 0, 80], "group": "back", "ply": {"axis": [1, 0, 0], "at": [29.9, 0, 0], "t": 1.2, "n": 9}, "texture": null}, {"id": "cross-h", "name": "back brace", "kind": "box", "u": [3.5, 57.5], "v": [29.9, 31.1], "w": [77.8, 83.8], "colour": "#D9B77F", "frm": [0, 0, 80], "group": "back", "ply": {"axis": [0, 1, 0], "at": [0, 29.9, 0], "t": 1.2, "n": 9}, "texture": null}, {"id": "wad-tr", "name": "wadding", "kind": "box", "u": [33.5, 56.5], "v": [33.5, 56.5], "w": [78.8, 83.8], "colour": "#F1ECE4", "frm": [0, 0, 80], "group": "back", "ply": null, "texture": "fluffy"}, {"id": "wad-bl", "name": "wadding", "kind": "box", "u": [4.5, 27.5], "v": [4.5, 27.5], "w": [78.8, 83.8], "colour": "#F1ECE4", "frm": [0, 0, 80], "group": "back", "ply": null, "texture": "fluffy"}, {"id": "driver", "name": "Celestion TSQ1845", "kind": "driver", "centre": [30.5, 30.5], "w": 3.5, "frame_r": 23.0, "cut_r": 20.75, "depth": 23.34, "flange": 1.3, "magnet_r": 8.0, "colour": "#1F1C1C", "frm": [0, 0, -80], "group": null}, {"id": "speakon-a", "name": "Speakon socket", "kind": "speakon", "centre": [15.0, 43.5], "w": 82.60000000000001, "colour": "#2F2F33", "frm": [0, 0, 40], "group": null}, {"id": "speakon-b", "name": "Speakon socket", "kind": "speakon", "centre": [20.0, 43.5], "w": 82.60000000000001, "colour": "#2F2F33", "frm": [0, 0, 40], "group": null}], "steps": [{"text": "The shell. First the handles: on the inside of each 15 mm side, glue up a block of three 15 mm ply frames and a 15 mm back, filling the space between where the ring braces will go. Each frame's hole starts one step higher, so the bottom of the pocket climbs inward like the Pirámide. Then the top and bottom go on over the sides. Face grain runs front to back.", "parts": ["top", "bottom", "left", "right", "handle-l-0", "handle-l-1", "handle-l-2", "handle-l-3", "handle-r-0", "handle-r-1", "handle-r-2", "handle-r-3"], "xray": false}, {"text": "The duct panels: one 12 mm panel, bevelled 45 degrees on both long edges, across each of two opposite corners, glued along both edges. Their front ends sit 50 mm in from the front edges: set them with the dry-fitted front panel. The walls make the other two sides of each triangular duct.", "parts": ["duct-tl", "duct-br"], "xray": true}, {"text": "Ring braces at 25 and 49 cm: each one is two L-shaped halves, cut at 45 degrees to meet the duct panels, with a 12 mm x 6 cm slot at the top and bottom for the spines. The front one goes in from the open front until it butts against the handle blocks, the rear one from the back until it butts against them too. Cut them tight, sand until they tap in, and glue them to the walls, the duct panels and the handle blocks.", "parts": ["ring-0a", "ring-0b", "ring-1a", "ring-1b"], "xray": true}, {"text": "Spines under the top and over the bottom: each slides in from the back through the slots in both ring braces, glued to the panel and into the slots. They stop 5 mm short of the back brace.", "parts": ["spine-top", "spine-bottom"], "xray": true}, {"text": "Glue blocks: a stop where the back of the front panel will sit, 50 mm in from the front edges (broken where the ducts run), and strips along the two corners with no duct.", "parts": ["gb-top", "gb-bottom", "gb-left", "gb-right", "gb-tr-0", "gb-bl-0", "gb-tr-1", "gb-bl-1", "gb-tr-2", "gb-bl-2"], "xray": true}, {"text": "The printed wedges, 4 per mouth, glued into the pockets behind where the teeth will be, from the open front. Dry-fit the front panel as the stop.", "parts": ["wedge-tl0", "wedge-tl1", "wedge-tl2", "wedge-tl3", "wedge-br0", "wedge-br1", "wedge-br2", "wedge-br3"], "xray": true}, {"text": "The front panel, with its doubler ring glued on behind, goes in from the front against the stop: set back 35 mm from the front edges, with no grille. Glue it, and screw through the walls.", "parts": ["doubler", "front"], "xray": false}, {"text": "Cleats round the back opening: 20 mm strips, set in 12 mm, glued and screwed to the walls.", "parts": ["cleat-top", "cleat-bottom", "cleat-left", "cleat-right"], "xray": true}, {"text": "The back, as one piece: the cross brace, 5 cm of wadding on the two quarters away from the ducts, and a stepped pocket for the Speakons behind an opening in the back: two 6 mm frames, each a step smaller, and a base plate. On the prototype the back screws to the cleats over foam gasket tape, so it can come off.", "parts": ["back", "cross-v", "cross-h", "wad-tr", "wad-bl", "pocket-0", "pocket-1", "pocket-base"], "xray": true}, {"text": "The driver: run the Speakon lead out through the hole, connect it, and screw the driver in (on a prototype for trying other drivers, M6 bolts into tee nuts).", "parts": ["driver"], "xray": false}, {"text": "Finished: 61 x 61 x 85 cm, about 49 kg. The two Speakon sockets sit at the bottom of the stepped pocket, below the surface of the back, so they can't snag when boxes are packed tight. They're wired in parallel so a second sub can daisy-chain from the first.", "parts": ["speakon-a", "speakon-b"], "xray": false, "finish": true}], "finishes": [{"name": "Birch", "colour": "#E8D2A6"}, {"name": "Orange", "colour": "#FF5A2C"}, {"name": "Fuchsia", "colour": "#E5007E"}, {"name": "Turquoise", "colour": "#00A4A6"}, {"name": "Sun", "colour": "#FFC400"}], "ink": "#2B201C", "background": "#FEC7AF"}