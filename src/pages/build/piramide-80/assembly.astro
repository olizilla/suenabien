---
// A 3D assembly of the current Pirámide 80, part by part in build order. Unlinked and kept out of search.
// The parts and steps in src/builds/piramide-80/assembly.json are generated by
// suena-bien-boxes/tools/piramide-80-build.py --web; edit them there, not here.
import Layout from '../../../layouts/Layout.astro';
import data from '../../../builds/piramide-80/assembly.json';
---

<Layout
  title={`Pirámide 80 assembly v${data.version} · Suena Bien`}
  desc="A 3D assembly of the Pirámide 80 sub, part by part."
  path="/build/piramide-80/assembly/"
  noindex
>
  <main class="asm font-inter max-w-5xl mx-auto px-4 pb-16">
    <header class="flex items-start justify-between gap-4 pt-6">
      <div>
        <a href="/build/piramide-80/" class="text-sm">Back to the build sheet</a>
        <h1 class="text-3xl font-extrabold mt-2">Pirámide 80: assembly</h1>
      </div>
      <p class="badge"><span class="badge-v">v{data.version}</span><span class="badge-date">{data.date}</span></p>
    </header>

    <div class="layout">
    <div class="left">
    <div id="stage" class="stage mt-4"></div>

    <div class="panel">
      <p class="count" id="count"></p>
      <p class="caption" id="caption"></p>
      <div class="bar">
        <div class="controls">
          <button id="prev">Back</button>
          <button id="play">Pause</button>
          <button id="next">Next</button>
          <button id="restart">Start again</button>
          <button id="xray">See inside: auto</button>
        </div>
        <div class="finishes" id="finishes">
          <span class="finish-label">Finish:</span>
          {data.finishes.map((f) => (
            <button class:list={['chip', { on: f.name === 'Birch' }]} data-colour={f.colour} data-name={f.name}
              title={f.name} aria-label={`${f.name} finish`} style={`background:${f.colour}`}></button>
          ))}
        </div>
      </div>
    </div>
    </div>

    <div class="right" id="right">
    <h2>Steps</h2>
    <ol class="steps" id="steps">
      {data.steps.map((s, i) => <li><button data-step={i}><span class="n">{i + 1}</span><span>{s.text}</span></button></li>)}
    </ol>
    </div>
    </div>
  </main>
</Layout>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import data from '../../../builds/piramide-80/assembly.json';

  const [F, , D] = data.size;
  const cx = F / 2, cz = D / 2;
  const HIGHLIGHT = '#00A4A6';
  const stage = document.getElementById('stage');

  // --- scene
  let renderer;
  try {
    renderer = new THREE.WebGLRenderer({ antialias: true });
  } catch (e) {
    stage.innerHTML = '<p class="no-3d">This browser can\'t show the 3D view (it needs WebGL). The steps below still describe the build.</p>';
    throw e;                                                           // nothing more to do without 3D
  }
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  stage.appendChild(renderer.domElement);
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(data.background);
  const camera = new THREE.PerspectiveCamera(32, 1, 0.3, 3000);
  camera.position.set(100, 80, 150);
  const controls = new OrbitControls(camera, renderer.domElement);
  controls.target.set(0, 28, 0);
  controls.enableDamping = true;
  controls.minDistance = 8;                                            // close enough to see the plies
  controls.maxDistance = 600;
  controls.maxPolarAngle = Math.PI / 2 - 0.03;
  controls.autoRotateSpeed = 1.2;
  scene.add(new THREE.HemisphereLight('#ffffff', '#e8a58c', 2.2));
  const sun = new THREE.DirectionalLight('#ffffff', 2.0);
  sun.position.set(80, 160, 120);
  scene.add(sun);
  const floor = new THREE.Mesh(new THREE.CircleGeometry(140, 64), new THREE.MeshBasicMaterial({ color: '#F5B49C' }));
  floor.rotation.x = -Math.PI / 2;
  floor.position.y = -0.1;
  scene.add(floor);

  // --- parts: coordinates in cm, u across, v up, w back from the front; the front faces +z
  const world = (u, v, w) => new THREE.Vector3(u - cx, v, cz - w);
  // Plywood edges: on faces that cut across the board, shade 11 plies (15 mm) or 9 (12 mm), alternating long-grain and
  // cross-grain, with dark glue lines that wobble a little. They fade to an even tone when smaller than a pixel or two.
  const PLY_VERT = 'varying vec3 vPly;';
  const NOISE = `
    float hash3(vec3 p) { p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
    float vnoise(vec3 x) {
      vec3 i = floor(x), f = fract(x);
      f = f * f * (3.0 - 2.0 * f);
      return mix(mix(mix(hash3(i), hash3(i + vec3(1, 0, 0)), f.x), mix(hash3(i + vec3(0, 1, 0)), hash3(i + vec3(1, 1, 0)), f.x), f.y),
                 mix(mix(hash3(i + vec3(0, 0, 1)), hash3(i + vec3(1, 0, 1)), f.x), mix(hash3(i + vec3(0, 1, 1)), hash3(i + vec3(1, 1, 1)), f.x), f.y), f.z);
    }
    float fbm(vec3 p) {
      float s = 0.0, a = 0.5;
      for (int k = 0; k < 4; k++) { s += a * vnoise(p); p = p * 2.03 + 1.7; a *= 0.5; }
      return s / 0.9375;
    }`;
  const PLY_FRAG = `varying vec3 vPly;
    uniform vec3 uAxis, uHome, uGrain;
    uniform float uOrigin, uThick, uLayers, uStrength, uSeed;` + NOISE;
  const PLY_CODE = `
    vec3 pp = vPly + uHome;
    vec3 fn = normalize(cross(dFdx(pp), dFdy(pp)));
    float across = 1.0 - smoothstep(0.3, 0.6, abs(dot(fn, uAxis)));
    if (across > 0.0) {
      float x = (dot(pp, uAxis) - uOrigin) / uThick * uLayers;
      vec3 q = pp - uAxis * dot(pp, uAxis);
      float s = q.x * 0.83 + q.y * 1.07 + q.z * 0.91;
      x += 0.16 * sin(s * 0.29 + x * 2.1) + 0.08 * sin(s * 1.31 + x * 5.3 + 1.7) + 0.04 * sin(s * 4.7 + x * 11.0 + 0.4);
      float li = floor(x), f = fract(x);
      float h = fract(sin(li * 12.9898 + 78.233) * 43758.5453);
      float tone = (mod(li, 2.0) < 0.5 ? 1.0 : 0.84) * (0.94 + 0.1 * h);
      tone = mix(0.6, tone, smoothstep(0.0, 0.09, f) * smoothstep(0.0, 0.09, 1.0 - f));
      tone = mix(tone, 0.88, smoothstep(0.35, 0.9, fwidth(x)));
      diffuseColor.rgb *= mix(1.0, tone, uStrength * across);
    } else {
      // the face veneer, like rotary-cut birch: soft lines that run broadly along the grain 3-5 cm apart, pushed into big
      // waves and tongues by a smooth warped noise, frayed only at the millimetre scale. Each is a thin darker line with a
      // soft halo on one side, over a faint cloud, warmer where darker. The lines fade out when they would be smaller than a
      // few pixels, and paint hides it all.
      vec3 cr = normalize(cross(uAxis, uGrain));
      float g = dot(pp, uGrain), c = dot(pp, cr);
      vec3 q = vec3(g * 0.009, c * 0.032, uSeed);
      q.xy += 0.9 * vec2(vnoise(q * 1.7 + 3.1), vnoise(q * 1.7 + 7.7)) - 0.45;
      float wave = 0.65 * vnoise(q) + 0.35 * vnoise(q * 2.03 + 1.7);
      float t = c * 0.36 + 17.0 * wave;                // the waves are steep enough to fold the lines into tongues
      t *= mix(0.55, 1.0, vnoise(vec3(g * 0.005, c * 0.011, uSeed + 5.0)));   // in places the bands open out wider
      t += 0.05 * (vnoise(vec3(g * 1.6, c * 3.2, uSeed + 3.0)) - 0.5) + 0.03 * (vnoise(vec3(g * 5.0, c * 9.0, uSeed + 9.0)) - 0.5);
      float f = fract(t), fw = fwidth(t);
      float line = 1.0 - smoothstep(0.02, 0.11 + fw, min(f, 1.0 - f));      // soft-edged lines
      float halo = 1.0 - smoothstep(0.0, 0.6, f);
      float vis = 1.0 - smoothstep(0.25, 0.7, fw);
      float d = vis * (0.075 * line + 0.04 * halo * halo) + 0.03 * (fbm(q * 3.0 + 11.0) - 0.5);
      vec3 veneer = vec3(1.0 - d) * mix(vec3(1.0), vec3(1.0, 0.94, 0.85), clamp(d * 6.0, 0.0, 1.0));
      diffuseColor.rgb *= mix(vec3(1.0), veneer, uStrength * uStrength);
    }`;
  // Wadding: a soft cloudy texture from a few octaves of value noise
  const FLUFF_FRAG = 'varying vec3 vPly;' + NOISE;
  const FLUFF_CODE = `
    float n = 0.5 * vnoise(vPly * 0.8) + 0.25 * vnoise(vPly * 1.9) + 0.125 * vnoise(vPly * 4.1);
    float fibre = vnoise(vPly * vec3(9.0, 2.0, 9.0));
    float tone = 0.86 + 0.2 * n + mix(0.05 * (fibre - 0.5), 0.0, smoothstep(0.3, 1.0, fwidth(vPly.x * 9.0)));
    diffuseColor.rgb *= tone;`;
  function fluffyMaterial(colour) {
    const m = material(colour);
    m.onBeforeCompile = (sh) => {
      sh.vertexShader = sh.vertexShader.replace('#include <common>', '#include <common>\n' + PLY_VERT)
        .replace('#include <begin_vertex>', '#include <begin_vertex>\nvPly = transformed;');
      sh.fragmentShader = sh.fragmentShader.replace('#include <common>', '#include <common>\n' + FLUFF_FRAG)
        .replace('vec4 diffuseColor = vec4( diffuse, opacity );', 'vec4 diffuseColor = vec4( diffuse, opacity );' + FLUFF_CODE);
    };
    m.customProgramCacheKey = () => 'fluffy';
    return m;
  }
  // The face grain runs along each panel's longest side; on a square panel, up and down.
  function setGrain(m, geom, seedText) {
    const u = m.userData.ply;
    if (!u) return;
    geom.computeBoundingBox();
    const size = new THREE.Vector3();
    geom.boundingBox.getSize(size);
    const axis = u.uAxis.value;
    let best = null;
    for (const [dir, len] of [[new THREE.Vector3(0, 1, 0), size.y + 0.01], [new THREE.Vector3(0, 0, 1), size.z], [new THREE.Vector3(1, 0, 0), size.x]]) {
      if (Math.abs(dir.dot(axis)) > 0.5) continue;
      if (!best || len > best[1] + 0.5) best = [dir, len];
    }
    u.uGrain.value.copy(best[0]).addScaledVector(axis, -best[0].dot(axis)).normalize();
    let h = 0;
    for (const ch of seedText) h = (h * 31 + ch.charCodeAt(0)) % 1009;
    u.uSeed.value = h / 37;
  }
  function plyMaterial(colour, ply) {
    const m = material(colour);
    const axis = new THREE.Vector3(ply.axis[0], ply.axis[1], -ply.axis[2]).normalize();
    const u = {
      uAxis: { value: axis }, uOrigin: { value: world(...ply.at).dot(axis) }, uThick: { value: ply.t },
      uLayers: { value: ply.n }, uStrength: { value: 1 }, uHome: { value: new THREE.Vector3() },
      uGrain: { value: new THREE.Vector3(0, 1, 0) }, uSeed: { value: 0 },
    };
    m.userData.ply = u;
    m.onBeforeCompile = (sh) => {
      Object.assign(sh.uniforms, u);
      sh.vertexShader = sh.vertexShader.replace('#include <common>', '#include <common>\n' + PLY_VERT)
        .replace('#include <begin_vertex>', '#include <begin_vertex>\nvPly = transformed;');
      sh.fragmentShader = sh.fragmentShader.replace('#include <common>', '#include <common>\n' + PLY_FRAG)
        .replace('vec4 diffuseColor = vec4( diffuse, opacity );', 'vec4 diffuseColor = vec4( diffuse, opacity );' + PLY_CODE);
    };
    m.customProgramCacheKey = () => 'ply';
    return m;
  }
  function speakon(p) {
    // a Neutrik-style socket on the outside of the back: square flange, round body, latch and two screws
    const g = new THREE.Group();
    const flange = new THREE.Mesh(new THREE.BoxGeometry(2.6, 3.1, 0.3), material(p.colour));
    flange.position.z = -0.15;
    outline(flange.geometry, flange);
    g.add(flange);
    const body = new THREE.CylinderGeometry(1.05, 1.05, 0.55, 40);
    body.rotateX(Math.PI / 2);
    const b = new THREE.Mesh(body, material('#26262a'));
    b.position.z = -0.575;
    outline(body, b);
    g.add(b);
    const face = new THREE.Mesh(new THREE.CircleGeometry(0.62, 32), material('#0e0e10'));
    face.position.z = -0.86;
    g.add(face);
    const latch = new THREE.Mesh(new THREE.BoxGeometry(0.55, 0.32, 0.3), material('#C9CED6'));
    latch.position.set(0, 1.25, -0.45);
    g.add(latch);
    for (const [x, y] of [[-0.95, 1.2], [0.95, -1.2]]) {
      const sc = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.16, 0.08, 12), material('#C9CED6'));
      sc.rotation.x = Math.PI / 2;
      sc.position.set(x, y, -0.34);
      g.add(sc);
    }
    g.position.copy(world(p.centre[0], p.centre[1], p.w));
    return g;
  }
  function material(colour) {
    return new THREE.MeshLambertMaterial({ color: colour, flatShading: true, side: THREE.DoubleSide });
  }
  function outline(geom, mesh) {
    const lines = new THREE.LineSegments(new THREE.EdgesGeometry(geom, 25),
                                         new THREE.LineBasicMaterial({ color: data.ink, transparent: true }));
    mesh.add(lines);
    return lines;
  }
  function shape(poly, holes = []) {
    const s = new THREE.Shape(poly.map(([a, b]) => new THREE.Vector2(a, b)));
    for (const h of holes) {
      const p = new THREE.Path();
      if (h.circle) p.absarc(h.circle[0], h.circle[1], h.circle[2], 0, Math.PI * 2, true);
      else p.setFromPoints(h.poly.map(([a, b]) => new THREE.Vector2(a, b)));
      s.holes.push(p);
    }
    return s;
  }
  function extrude(s, a0, a1, axis) {
    const g = new THREE.ExtrudeGeometry(s, { depth: a1 - a0, bevelEnabled: false, curveSegments: 48 });
    const m = new THREE.Matrix4();
    if (axis === 'w') m.set(1, 0, 0, -cx, 0, 1, 0, 0, 0, 0, -1, cz - a0, 0, 0, 0, 1);       // (u, v) shape, along w
    else m.set(0, 0, 1, a0 - cx, 0, 1, 0, 0, -1, 0, 0, cz, 0, 0, 0, 1);                      // (w, v) shape, along u
    g.applyMatrix4(m);
    return g;
  }
  function loft(sections) {
    const pos = [];
    const P = (s, j) => world(s.pts[j][0], s.pts[j][1], s.w);
    for (let i = 0; i < sections.length - 1; i++) {
      for (let j = 0; j < 3; j++) {
        const a = P(sections[i], j), b = P(sections[i], (j + 1) % 3), c = P(sections[i + 1], (j + 1) % 3), d = P(sections[i + 1], j);
        pos.push(...a.toArray(), ...b.toArray(), ...c.toArray(), ...a.toArray(), ...c.toArray(), ...d.toArray());
      }
    }
    const f = sections[0];
    pos.push(...P(f, 0).toArray(), ...P(f, 1).toArray(), ...P(f, 2).toArray());
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
    g.computeVertexNormals();
    return g;
  }
  function driver(p) {
    const grp = new THREE.Group();
    const [u, v] = p.centre;
    const add = (geom, colour, edges) => {
      geom.rotateX(-Math.PI / 2);
      const m = new THREE.Mesh(geom, material(colour));
      if (edges) outline(geom, m);
      grp.add(m);
      return m;
    };
    const ring = new THREE.Shape();
    ring.absarc(0, 0, p.frame_r, 0, Math.PI * 2, false);
    const hole = new THREE.Path();
    hole.absarc(0, 0, p.cut_r - 1.2, 0, Math.PI * 2, true);
    ring.holes.push(hole);
    const flange = new THREE.ExtrudeGeometry(ring, { depth: p.flange, bevelEnabled: false, curveSegments: 64 });
    const fl = new THREE.Mesh(flange, material(p.colour));               // sits on the front panel's face, 13 mm proud
    outline(flange, fl);
    grp.add(fl);
    const trim = new THREE.Mesh(new THREE.TorusGeometry(19.6, 0.35, 8, 96), material('#C9CED6'));
    trim.position.z = p.flange + 0.1;
    grp.add(trim);
    const cone = [[19.6, -0.2], [17, 2.5], [13, 6], [9, 9.6], [6.2, 11.8]].map(([r, o]) => new THREE.Vector2(r, o));
    add(new THREE.LatheGeometry(cone, 72), '#2a2626', false);
    const R = 10, th = Math.asin(6.2 / R), c = 11.8 + R * Math.cos(th);
    const cap = new THREE.SphereGeometry(R, 48, 8, 0, Math.PI * 2, Math.PI - th, th);
    cap.translate(0, c, 0);
    add(cap, '#1a1717', false);
    const basket = new THREE.CylinderGeometry(9, p.cut_r - 0.5, 15.7, 8, 1, true);
    basket.translate(0, 1.3 + 15.7 / 2, 0);
    add(basket, '#3a3535', true);
    const magnet = new THREE.CylinderGeometry(p.magnet_r, p.magnet_r, p.depth - 17, 40);
    magnet.translate(0, 17 + (p.depth - 17) / 2, 0);
    add(magnet, '#2c2828', true);
    grp.position.copy(world(u, v, p.w));
    return grp;
  }

  const parts = new Map();
  for (const p of data.parts) {
    let obj, geom;
    const mat = p.ply ? plyMaterial(p.colour, p.ply) : p.texture === 'fluffy' ? fluffyMaterial(p.colour) : material(p.colour);
    if (p.kind === 'box') {
      geom = new THREE.BoxGeometry(p.u[1] - p.u[0], p.v[1] - p.v[0], p.w[1] - p.w[0]);
      obj = new THREE.Mesh(geom, mat);
      obj.position.copy(world((p.u[0] + p.u[1]) / 2, (p.v[0] + p.v[1]) / 2, (p.w[0] + p.w[1]) / 2));
      if (p.ply) mat.userData.ply.uHome.value.copy(obj.position);       // the plies are drawn from the home position
    } else if (p.kind === 'prism') {
      geom = extrude(shape(p.poly, p.holes), p.a[0], p.a[1], p.axis);
      obj = new THREE.Mesh(geom, mat);
    } else if (p.kind === 'ring') {
      const s = new THREE.Shape();
      s.absarc(p.centre[0], p.centre[1], p.r[1], 0, Math.PI * 2, false);
      const h = new THREE.Path();
      h.absarc(p.centre[0], p.centre[1], p.r[0], 0, Math.PI * 2, true);
      s.holes.push(h);
      geom = extrude(s, p.a[0], p.a[1], 'w');
      obj = new THREE.Mesh(geom, mat);
    } else if (p.kind === 'loft') {
      geom = loft(p.sections);
      obj = new THREE.Mesh(geom, material(p.colour));
    } else if (p.kind === 'driver') {
      obj = driver(p);
    } else if (p.kind === 'speakon') {
      obj = speakon(p);
    }
    if (geom && p.ply) setGrain(mat, geom, p.id);
    const lines = geom && p.name !== 'wadding' ? outline(geom, obj) : null;
    const home = obj.position.clone();
    const away = new THREE.Vector3(p.frm[0], p.frm[1], -p.frm[2]);
    obj.visible = false;
    scene.add(obj);
    parts.set(p.id, { p, obj, lines, home, away });
  }

  // --- see-through walls while the inside is being built
  const xrayIds = ['top', 'bottom', 'left', 'right', 'front', 'doubler'];
  let xrayMode = 'auto';
  function setXray(on) {
    for (const id of xrayIds) {
      const { obj, lines } = parts.get(id);
      obj.material.transparent = on;
      obj.material.opacity = on ? 0.14 : 1;
      obj.material.depthWrite = !on;
      if (lines) lines.material.opacity = on ? 0.35 : 1;
    }
  }

  // --- the timeline
  const steps = data.steps;
  const stepOf = new Map();
  steps.forEach((s, i) => s.parts.forEach((id) => stepOf.set(id, i)));
  let current = 0, t = 0, playing = true;
  const MOVE = 1.3, STAGGER = 0.12, HOLD = 3.2;
  const duration = (i) => MOVE + STAGGER * Math.max(0, steps[i].parts.length - 1) + HOLD;
  const ease = (x) => 1 - Math.pow(1 - Math.min(1, Math.max(0, x)), 3);

  const right = document.getElementById('right');
  // the finished box spins until someone takes hold of the view; Start again lets it spin again
  let spinStopped = false;
  controls.addEventListener('start', () => { spinStopped = true; controls.autoRotate = false; });

  function show() {
    const s = steps[current];
    document.getElementById('count').textContent = `Step ${current + 1} of ${steps.length}`;
    document.getElementById('caption').textContent = s.text;
    document.getElementById('play').textContent = playing ? 'Pause' : 'Play';
    document.querySelectorAll('#steps button').forEach((b, i) => b.classList.toggle('on', i === current));
    // side by side: leave the text still until the highlight runs off the bottom (or is above, after Back or Start
    // again), then turn the page so the highlighted step sits at the top
    if (getComputedStyle(right).overflowY === 'auto') {
      const on = right.querySelector('#steps button.on');
      const top = on.getBoundingClientRect().top - right.getBoundingClientRect().top + right.scrollTop;
      const bottom = top + on.offsetHeight;
      if (bottom > right.scrollTop + right.clientHeight - 8 || top < right.scrollTop) {
        right.scrollTo({ top: current === 0 ? 0 : Math.max(0, top - 12), behavior: 'smooth' });
      }
    }
    setXray(xrayMode === 'on' || (xrayMode === 'auto' && !!s.xray));
    controls.autoRotate = !!s.finish && playing && !spinStopped;
  }
  function go(i) {
    current = (i + steps.length) % steps.length;
    t = 0;
    show();
  }
  function place() {
    for (const { obj, lines, home, away, p } of parts.values()) {
      const k = stepOf.get(p.id);
      obj.visible = k <= current;
      if (k < current) obj.position.copy(home);
      if (k === current) {
        const n = steps[current].parts.indexOf(p.id);
        const e = ease((t - n * STAGGER) / MOVE);
        obj.position.copy(home).addScaledVector(away, 1 - e);
      }
      if (lines) lines.material.color.set(k === current && t < duration(current) - 0.5 ? HIGHLIGHT : data.ink);
    }
  }

  document.getElementById('prev').onclick = () => go(current - 1);
  document.getElementById('next').onclick = () => go(current + 1);
  document.getElementById('restart').onclick = () => { playing = true; spinStopped = false; go(0); };
  document.getElementById('play').onclick = () => { playing = !playing; show(); };
  document.getElementById('xray').onclick = (e) => {
    xrayMode = { auto: 'on', on: 'off', off: 'auto' }[xrayMode];
    e.target.textContent = `See inside: ${xrayMode}`;
    show();
  };
  document.querySelectorAll('#steps button').forEach((b) => (b.onclick = () => { go(Number(b.dataset.step)); }));
  document.querySelectorAll('#finishes button').forEach((b) => (b.onclick = () => {
    const natural = b.dataset.name === 'Birch';
    document.querySelectorAll('#finishes button').forEach((c) => c.classList.toggle('on', c === b));
    for (const id of ['top', 'bottom', 'left', 'right', 'front', 'back']) {
      const { obj, p } = parts.get(id);
      obj.material.color.set(natural ? p.colour : b.dataset.colour);
      if (obj.material.userData.ply) obj.material.userData.ply.uStrength.value = natural ? 1 : 0.3;
    }
  }));

  function resize() {
    const w = stage.clientWidth, h = stage.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  new ResizeObserver(resize).observe(stage);
  resize();

  const timer = new THREE.Timer();
  if (import.meta.env.DEV) window.__asm = { camera, controls };   // for screenshots while developing
  renderer.setAnimationLoop((time) => {
    timer.update(time);
    const dt = Math.min(timer.getDelta(), 0.1);
    if (playing) {
      t += dt;
      if (t > duration(current) && !steps[current].finish) go(current + 1);
    } else {
      t = Math.max(t, MOVE + STAGGER * steps[current].parts.length);   // paused: finish the step's moves
    }
    place();
    controls.update();
    renderer.render(scene, camera);
  });
  go(0);
</script>

