---
// The current Pirámide 80 build sheet. Its data in src/builds/piramide-80/ is generated by
// suena-bien-boxes/tools/piramide-80-build.py --web; edit it there, not here.
// Old versions are frozen copies in src/builds/piramide-80/vN/, shown by [version].astro.
import BuildSheet from '../../../components/BuildSheet.astro';
import sheet from '../../../builds/piramide-80/sheet.json';
import { Content } from '../../../builds/piramide-80/checklist.md';

const archived = Object.keys(import.meta.glob('../../../builds/piramide-80/v*/sheet.json'))
  .map((f) => Number(f.match(/\/v(\d+)\//)[1]));
---

<BuildSheet sheet={sheet} Checklist={Content} path="/build/piramide-80/" archived={archived}
  assemblyHref="/build/piramide-80/assembly/" />
