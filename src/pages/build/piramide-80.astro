---
// Build sheet for the Pirámide 80 sub. Unlinked and kept out of search: share the URL directly.
// The drawings, notes, parts and versions in src/builds/piramide-80/ are generated by
// suena-bien-boxes/tools/piramide-80-build.py --web; edit them there, not here.
import Layout from '../../layouts/Layout.astro';
import sheet from '../../builds/piramide-80/sheet.json';
import { Content as Checklist } from '../../builds/piramide-80/checklist.md';

const latest = sheet.versions[0];
---

<Layout
  title={`Pirámide 80 build sheet v${sheet.version} · Suena Bien`}
  desc={`Drawings, parts and build checklist for the Pirámide 80 sub. Version ${sheet.version}, ${sheet.date}.`}
  path="/build/piramide-80/"
  noindex
>
  <main class="build font-inter max-w-5xl mx-auto px-4 pb-16">
    <header class="flex items-start justify-between gap-4 pt-6">
      <div>
        <a href="/" class="no-print"><img src="/suenabien.png" alt="Suena Bien" width="56" height="56" /></a>
        <h1 class="text-3xl font-extrabold mt-3">Pirámide 80: build sheet</h1>
      </div>
      <p class="badge" title={`Version ${sheet.version}`}>
        <span class="badge-v">v{sheet.version}</span>
        <span class="badge-date">{sheet.date}</span>
      </p>
    </header>

    <ul class="summary mt-4">
      {sheet.summary.map((s) => <li>{s}</li>)}
    </ul>
    <p class="mt-3"><strong>Changes in v{latest.version}:</strong> {latest.note}.</p>
    <p class="mt-2 text-sm">
      The duct sizes are model results, so measure the first box before building the rest (see the checklist).
      The drawings are to scale: printed at 100% on A4 they are 1:6, and the mouth detail is 1:3.
    </p>

    <ul class="legend mt-4">
      {sheet.legend.map((l) => <li><span class="swatch" style={`background:${l.colour}`}></span>{l.label}</li>)}
      <li><span class="marker">1</span>numbered notes, listed beside each drawing</li>
    </ul>

    {sheet.views.map((v) => (
      <section class="view" id={v.id}>
        <h2>{v.title}</h2>
        <div class="view-body">
          <figure set:html={v.svg} style={`--wcm:${v.wcm}`} />
          <div>
            <ol class="notes">
              {v.notes.filter((n) => n.n).map((n) => (
                <li><span class="marker">{n.n}</span><span>{n.text}</span></li>
              ))}
            </ol>
            {v.notes.filter((n) => !n.n).map((n) => <p class="mt-3">{n.text}</p>)}
            <p class="scale">Scale {v.scale} when printed at 100% on A4.</p>
          </div>
        </div>
      </section>
    ))}

    <section class="view" id="parts">
      <h2>Parts (one box)</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Part</th><th>Count</th><th>Size</th><th>Material</th></tr></thead>
          <tbody>
            {sheet.parts.map((p) => (
              <tr><td>{p.name}</td><td>{p.count}</td><td>{p.size}</td><td>{p.material}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="view checklist" id="checklist">
      <h2>Checklist</h2>
      <Checklist />
    </section>

    <section class="view" id="versions">
      <h2>Versions</h2>
      <ul class="versions">
        {sheet.versions.map((v) => <li><strong>v{v.version}, {v.date}:</strong> {v.note}.</li>)}
      </ul>
    </section>
  </main>
</Layout>

<style>
  .build { color: #2b201c; line-height: 1.5; }
  .build h2 { font-size: 1.25rem; font-weight: 800; margin: 2.5rem 0 0.75rem; }
  .badge {
    display: flex; flex-direction: column; align-items: center; flex: none;
    background: #2b201c; color: #fec7af; border-radius: 6px; padding: 0.4rem 0.9rem;
  }
  .badge-v { font-size: 2rem; font-weight: 900; line-height: 1; }
  .badge-date { font-size: 0.7rem; font-weight: 700; margin-top: 0.2rem; }
  .summary { list-style: disc; padding-left: 1.25rem; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; font-size: 0.875rem; }
  .legend li { display: flex; align-items: center; gap: 0.4rem; }
  .swatch { width: 1rem; height: 1rem; border: 1px solid #a88a5c; display: inline-block; }
  .marker {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 1.5rem; height: 1.5rem; border-radius: 999px;
    background: #2b201c; color: #fff; font-size: 0.75rem; font-weight: 900;
  }
  .view-body { display: grid; gap: 1rem 2rem; }
  @media (min-width: 768px) {
    .view-body { grid-template-columns: 3fr 2fr; align-items: start; }
  }
  .view figure :global(svg) { display: block; width: 100%; height: auto; }
  .notes li { display: flex; gap: 0.6rem; align-items: baseline; margin-bottom: 0.6rem; }
  .notes .marker { transform: translateY(0.3rem); }
  .scale { font-size: 0.8rem; margin-top: 0.75rem; opacity: 0.8; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  th, td { text-align: left; vertical-align: top; padding: 0.4rem 0.6rem; border-bottom: 1px solid #d9a58e; }
  th { font-weight: 800; }
  .versions li { margin-bottom: 0.4rem; }
  .checklist :global(h2) { font-size: 1.05rem; font-weight: 800; margin: 1.5rem 0 0.5rem; }
  .checklist :global(ul) { list-style: disc; padding-left: 1.25rem; }
  .checklist :global(ul ul) { margin-top: 0.25rem; }
  .checklist :global(li) { margin-bottom: 0.35rem; }
  .checklist :global(p) { margin: 0.6rem 0; }
  .checklist :global(code) { font-size: 0.85em; }

  @media print {
    @page { size: A4 portrait; margin: 12mm; }
    :global(html), :global(body) { background: #fff !important; }
    .no-print { display: none; }
    .build { max-width: none; padding: 0; font-size: 10pt; }
    .badge { background: none; color: #2b201c; border: 2px solid #2b201c; }
    .marker, .swatch { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .view + .view { break-before: page; }
    #versions { break-before: auto; }
    .view h2 { margin-top: 0; }
    .view-body { display: block; }
    /* True scale: 1 cm of box = 10 / 6 mm of paper. */
    .view figure :global(svg) { width: calc(var(--wcm) * 10mm / 6); max-width: 100%; margin-bottom: 4mm; }
    .notes li { break-inside: avoid; }
    tr { break-inside: avoid; }
  }
</style>
