---
import'../base.css';
// Pages can set their own title and description. `path` is the page's URL path, for the canonical link.
// `noindex` keeps a page out of search engines: for unlinked pages, like the build sheets.
const {
  title = "Suena Bien Soundsystem",
  desc = "Making speakers. Playing music. Partying together.",
  path = "",
  noindex = false,
} = Astro.props
const site = "https://suenabien.co"
const url = `${site}${path}`
const img = `${site}/suenabien.png`
const alt = "Round red sticker that says Suena Bien in dancing letters"
const col = "#FF7145"
---
<!doctype html>
<html lang="en" style="background:#FEC7AF;">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/suenabien.png">
		<title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Suena Bien Soundsystem" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={img} />
    <meta property="og:image:alt" content={alt} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content={col} />
	</head>
	<body>
		<slot />
	</body>
</html>
